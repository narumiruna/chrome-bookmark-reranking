{
  "name": "bookmark-compass",
  "version": "0.1.0",
  "private": true,
  "description": "Search and semantically rerank Chrome bookmarks with TypeSafe AI.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "extension dev",
    "start": "extension start",
    "build": "extension build --browser chrome",
    "pack": "extension build --browser chrome --zip",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "test": "vitest run",
    "ci": "npm run check && npm test && npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "extension": "^4.1.25",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
